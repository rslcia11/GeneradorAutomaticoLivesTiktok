# Plantilla de /etc/tarot/<cliente>.env — UNA por cliente. Permisos 0600.
# Copiar, rellenar, y nunca subir a git.

# --- Quién ---
TIKTOK_USERNAME=usuario_sin_arroba

# --- Overlay ---
# Puerto interno (solo loopback). Único por cliente: 8081, 8082, ...
# Debe coincidir con el bloque del cliente en /etc/caddy/Caddyfile.
GATEWAY_PORT=8081
# Clave del overlay. Generar con: node scripts/make-key.js
# Va en la URL de OBS: https://DOMINIO/<cliente>/?avatar=animado&key=ESTA_CLAVE
OVERLAY_KEY=

# --- IA ---
GEMINI_API_KEY=

# --- Voz (opcional) ---
TTS_ENABLED=true
TTS_VOICE=es-MX-JorgeNeural

# --- Lo que ve el público ---
CONTACT_ENABLED=true
CONTACT_TEXT=✨ ¿Quieres una consulta personalizada? Escríbeme al 09XXXXXXXX
CONTACT_PHONE=09XXXXXXXX
CONTACT_VISIBLE_SECONDS=12
# Reaparece al azar entre estos dos, en SEGUNDOS: nunca con un compás fijo,
# que es lo que TikTok lee como bucle automático.
CONTACT_GAP_MIN_SECONDS=15
CONTACT_GAP_MAX_SECONDS=60
PROMO_ENABLED=false
PROMO_TEXT=

# --- Registro ---
LOG_LEVEL=INFO
